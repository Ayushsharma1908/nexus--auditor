# Server Environment Variables Template (Render / Local)
# DO NOT commit real secrets here. Set these in Render Dashboard -> Environment Variables.

# Server Port (Render sets this dynamically)
PORT=8080

# MongoDB Atlas Connection URI & Database Name
# Example URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexus_comply?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/nexus_comply
SPRING_DATA_MONGODB_DATABASE=nexus_comply

# Gemini AI Key & Provider Settings
NEXUS_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-1.5-flash
GEMINI_API_TIMEOUT_SECONDS=10

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app
