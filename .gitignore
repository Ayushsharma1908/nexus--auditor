# ==============================================================================
# NEXUS-COMPLY .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.env
*.secret
*.secrets
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
*.crt
*.der
*.cer
id_rsa
id_ed25519
*.id_rsa
*.id_ed25519

# Cloud & Service Credentials
credentials.json
service-account*.json
client_secrets*.json
google-services*.json
aws-credentials*
azure-credentials*
firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 2. Java / Spring Boot / Maven / Gradle / JVM
# ------------------------------------------------------------------------------
# Maven build output
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle build output
.gradle/
**/build/
!src/**/build/

# Compiled Java / Class files
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 3. Node.js / Vite / React / Frontend
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
**/out/
.next/
.nuxt/
.vuepress/dist/
.serverless/
.fusebox/
.dynamodb/
.tern-port

# Vite cache
.vite/

# Package manager logs & cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Coverage and testing
**/coverage/
.nyc_output/
.lcov/

# Linter caches
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Databases, Local Storage, Uploads & Dumps
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.h2.db
*.mv.db
*.trace.db

# SQL / DB Dumps
*.sql
*.dump
*.rdb

# App uploads / temp media
uploads/
**/uploads/
storage/
**/storage/
attachments/
**/attachments/

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
*.log.*
temp/
**/temp/
tmp/
**/tmp/
*.tmp
*.bak
*.swp
*.swo
*~
*.orig

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tools
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.ionide/

# IntelliJ IDEA / WebStorm / PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/

# Patch / Diff files
*.patch
*.diff

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*
