# ==============================================================================
# NEXUS-COMPLY Global Environment Template
# ==============================================================================
# Copy this file to .env for local development.
# For production (Vercel / Render), configure variables in their respective dashboards.

# ------------------------------------------------------------------------------
# Backend & Database Settings (Render / Server)
# ------------------------------------------------------------------------------
PORT=8080
# MongoDB Atlas Connection URI:
# mongodb+srv://<db_user>:<db_password>@<cluster-host>/nexus_comply?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/nexus_comply

# AI Provider Configuration (Google Gemini / Fallback Stub)
NEXUS_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-1.5-flash
GEMINI_API_TIMEOUT_SECONDS=10

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app

# ------------------------------------------------------------------------------
# Frontend Settings (Vercel / Client)
# ------------------------------------------------------------------------------
# In local development: /api/v1 (routed through Vite dev proxy)
# In production on Vercel: https://<your-render-app>.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
